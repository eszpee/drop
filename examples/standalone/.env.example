# The address people will use; the tunnel's public hostname must match it.
PUBLIC_URL=https://drop.example.com

# Cloudflare dashboard → Zero Trust → Networks → Tunnels → your tunnel → the token
# in its `cloudflared tunnel run --token …` command.
TUNNEL_TOKEN=

TZ=UTC

# Largest file; everything stored, uploads in progress included; and the free
# space no upload may eat into. Sized for the disk behind the Docker volume.
MAX_FILE_SIZE=10G
MAX_TOTAL=100G
MIN_FREE=20G
